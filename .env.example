# Local development defaults. Choose private values before deploying elsewhere.
FRONTEND_PORT=4200
# MySQL is accessible only from this computer, e.g. using DBeaver.
MYSQL_PORT=3307
MYSQL_DATABASE=chatroom
MYSQL_USER=chatroom
MYSQL_PASSWORD=chatroom-local-password
MYSQL_ROOT_PASSWORD=chatroom-local-root-password
# At least 32 bytes (32 ASCII characters) for HMAC signing.
JWT_SECRET=local-development-secret-change-me-at-least-32-bytes

# Local AI agents: no API key or cloud provider is required.
AI_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
AI_INTERVAL_SECONDS=15
AI_MAX_AUTONOMOUS_TURNS=6
AI_REQUEST_TIMEOUT_SECONDS=120
